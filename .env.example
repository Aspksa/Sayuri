# Copy to .env; keep it private. Never commit a real key.
CLOUD_RU_API_KEY=
# Use the actual OpenAI-compatible Cloud.ru Foundation Models API base URL.
CLOUD_RU_BASE_URL=
CLOUD_RU_MODEL=
# Optional external persistent location for chats and uploads:
# SAYURI_DATA_DIR=C:/Users/USERNAME/Documents/Облако/Sayuri

# Explicitly grant access to the root containing "Рабочие проекты" and "Домашние проекты".
# Example: C:/Users/USERNAME/Documents/Облако/Sayuri
SAYURI_PROJECTS_DIR=
