# Copy to .env; keep it private. Never commit a real key.
CLOUD_RU_API_KEY=
# Use the actual OpenAI-compatible Cloud.ru Foundation Models API base URL.
CLOUD_RU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUD_RU_MODEL=
# Optional external persistent location for chats and uploads:
# SAYURI_DATA_DIR=C:/Users/USERNAME/Documents/Облако/Sayuri

# Explicitly grant access to the root containing "Рабочие проекты" and "Домашние проекты".
# Example: C:/Users/USERNAME/Documents/Облако/Sayuri
SAYURI_PROJECTS_DIR=

# Model №02: DeepSeek-V4.1-Flash mentor. Enter the exact ID returned by Cloud.ru /models.
# This model name has not been verified in the public Cloud.ru catalog.
# If your Cloud.ru account does not expose it, mentor chat will remain unavailable.
CLOUD_RU_TEACHER_MODEL=
# When enabled, mentor exchanges are analyzed in a separate paid API call.
# Proposed memory entries are NOT saved without owner approval.
SAYURI_AUTO_OBSERVE=1
# Model №01: Sayuri response engine. Choose a supported Cloud.ru model via /models.


# Windows-only shortcut: open the personal dashboard with no password on localhost.
# This is not safe for deployment to other computers or the internet.
SAYURI_LOCAL_ACCESS=1
# SAYURI_HOST=127.0.0.1
